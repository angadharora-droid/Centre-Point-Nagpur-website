# Public HTTPS origin of the deployed Railway service (or your custom domain).
# Enables SEO indexing, canonical links and the sitemap. Origin only, no path.
PUBLIC_SITE_URL=

# MongoDB connection string for storing event enquiries. Without it the site
# still runs and the enquiry form reports that submissions are unavailable.
MONGODB_URI=
MONGODB_DB=centrepoint

# Bearer token required to read submitted enquiries at GET /api/enquiries.
ADMIN_TOKEN=

# Only needed if the API is ever moved to a separate origin. Left blank, the
# frontend calls /api on its own origin.
PUBLIC_API_BASE_URL=

# Extra cross-origin callers allowed to reach /api (comma-separated, exact
# origins). Same-origin requests never need this.
FRONTEND_ORIGINS=
